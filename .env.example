# BUILD-TIME public variables. Copy to `.env.local` (gitignored) and fill in.
#
# These cannot live in `.dev.vars`. Next inlines NEXT_PUBLIC_* into the bundle
# at BUILD time and reads only real environment variables and .env files at
# that point — never `.dev.vars`, never `wrangler.jsonc` vars, both of which are
# resolved at request time. Verified empirically 2026-08-04.
#
# For deploys, set these as CI build-step variables BEFORE
# `opennextjs-cloudflare build`. `wrangler secret put` is always too late: the
# bundle has already been built.
#
# Server-side secrets go in `.dev.vars` instead — see `.dev.vars.example`.
#
# ⚠️ Every variable here is public and readable by anyone. Nothing secret.

# P-6  Privy app id. Public by design; it identifies the app to Privy.
# From: dashboard.privy.io -> App settings -> Basics
# Without it, `isAuthConfigured` is false and login is silently absent.
NEXT_PUBLIC_PRIVY_APP_ID=

# P-1  Builder code, same value as POLYMARKET_BUILDER_CODE in .dev.vars.
# Needed in the browser because orders are signed client-side. Safe to expose:
# it is written into the signed order struct and emitted in the on-chain
# OrderFilled event, so it is already public.
NEXT_PUBLIC_POLYMARKET_BUILDER_CODE=
