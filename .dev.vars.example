# Local development secrets. Copy to `.dev.vars` (gitignored) and fill in.
#
# In production these are set with `wrangler secret put <NAME>` — never
# committed and never placed in wrangler.jsonc.
#
# All values are supplied by the client. See implementation.md section 1.
# The app runs in "mock" mode with these blank: every screen renders and every
# code path is exercised, but no order is signed or submitted.

# P-1  Builder code, bytes32 hex, from polymarket.com -> Settings -> Builders
#
# Needed in BOTH places, because orders are signed in the browser:
#   here                -> server-side reads (health, diagnostics)
#   .env.local          -> NEXT_PUBLIC_POLYMARKET_BUILDER_CODE, same value
#
# Safe in the client bundle, unlike the credentials below: the code is written
# into the signed order struct and emitted in the on-chain OrderFilled event,
# so it is already public.
POLYMARKET_BUILDER_CODE=

# P-2..P-4  Builder API credentials. Secret and passphrase are shown ONCE.
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# OI-6  Fee rates in basis points. Caps: taker 100, maker 50. Users pay these
# ON TOP of Polymarket's own fees.
BUILDER_FEE_BPS_TAKER=0
BUILDER_FEE_BPS_MAKER=0

# P-6  Privy app secret. Server-side only, read at request time.
PRIVY_APP_SECRET=

# NEXT_PUBLIC_PRIVY_APP_ID does NOT belong here.
#
# Next inlines NEXT_PUBLIC_* into the bundle at BUILD time, and it reads only
# real environment variables / .env files at that point — never .dev.vars or
# wrangler.jsonc `vars`, both of which are resolved at request time. Verified
# empirically 2026-08-04: setting it here leaves the client bundle with an
# empty app id, so `isAuthConfigured` is false, <PrivyProvider> never mounts,
# and login silently cannot work.
#
#   local  -> .env.local  (gitignored)
#   CI     -> a build-step environment variable, before `opennextjs-cloudflare build`
#
# `wrangler secret put NEXT_PUBLIC_PRIVY_APP_ID` is always too late — the
# bundle is already built.

# P-9  Polygon RPC
POLYGON_RPC_URL=
